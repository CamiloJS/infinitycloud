# =====================================================================
# INFINITY - VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo a .env.local y completa con tus credenciales reales
# =====================================================================

# 1. Configuración de Firebase Client (Web SDK)
# Obtenida en: Firebase Console > Configuración del Proyecto > General > Tus apps > App Web
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA_example_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto-infinity.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-infinity
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto-infinity.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# 2. Configuración de Firebase Admin (Server SDK)
# Obtenida en: Firebase Console > Cuentas de servicio > Generar nueva clave privada
FIREBASE_PROJECT_ID=tu-proyecto-infinity
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-infinity.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. Claves de cifrado y seguridad del servidor
# Clave para cifrar los tokens de Notion de los usuarios en reposo (AES-256-GCM)
NOTION_ENCRYPTION_KEY=clave_secreta_de_32_caracteres_o_mas_para_cifrado

# Secreto para sesiones y cookies
SESSION_SECRET=secreto_de_sesion_seguro_infinity_2026
